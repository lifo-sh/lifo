  "peerDependencies": { "@lifo-sh/core": "workspace:*" },
  "peerDependenciesMeta": { "@lifo-sh/core": { "optional": true } },
  "devDependencies": { "@lifo-sh/core": "workspace:*", "typescript": "^5.7.0", "vite": "^6.0.0", "vite-plugin-dts": "^4.5.0", "vitest": "^3.0.0" }
}

{
  "name": "lifo-pkg-agent",
  "version": "0.1.0",
  "description": "An in-browser AI agent (WebLLM on WebGPU) and a text web browser for Lifo",
  "license": "MIT",
  "author": "Sanket Sahu",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./worker": {
      "import": "./dist/worker.js",
      "types": "./dist/worker.d.ts"
    },
    "./proxy": {
      "import": "./dist/proxy.js",
      "types": "./dist/proxy.d.ts"
    },
    "./firefox": {
      "import": "./dist/firefox.js",
      "types": "./dist/firefox/index.d.ts"
    },
    "./chromium": {
      "import": "./dist/chromium.js",
      "types": "./dist/chromium/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "lifo": {
    "commands": {
      "agent": "./dist/index.js",
      "browser": "./dist/browser.js"
    }
  },
  "keywords": [
    "lifo-pkg",
    "agent",
    "webllm",
    "webgpu",
    "browser-use"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ../../scripts/ensure-pnpm-publish.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.87"
  },
  "peerDependencies": {
    "@lifo-sh/core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@lifo-sh/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lifo-sh/core": "workspace:*",
    "@types/node": "^22.0.0",
    "linkedom": "^0.18.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0"
  }
}
